@page "/projects"
@using KanbanBoard.Client.Services
@inject ApiService Api
@inject NavigationManager Nav

<h3>Мои проекты</h3>

<div class="project-form">
    <input @bind="newProjectName" placeholder="Название нового проекта" />
    <button @onclick="CreateProject">+ Создать проект</button>
</div>

@if (projects == null)
{
    <p>Загрузка...</p>
}
else if (projects.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon">✕</div>
        <div class="empty-state-title">Пока нет ни одного проекта</div>
        <div class="empty-state-text">
            Создайте первый проект, чтобы начать работу с Kanban-доской.
        </div>
    </div>
}
else
{
    <div class="project-list">
        @foreach (var p in projects)
        {
            <div class="project-card">
                <a href="/boardpage/@p.Id">@p.Name</a>
            </div>
        }
    </div>
}

@code {
    private List<Project>? projects;
    private string newProjectName = "";

    protected override async Task OnInitializedAsync()
    {
        if (!await Api.IsAuthenticatedAsync())
        {
            Nav.NavigateTo("/login");
            return;
        }
        projects = await Api.GetProjectsAsync();
    }

    private async Task CreateProject()
    {
        if (string.IsNullOrWhiteSpace(newProjectName)) return;
        await Api.CreateProjectAsync(newProjectName);
        newProjectName = "";
        projects = await Api.GetProjectsAsync();
    }
}